# Required: The Movie Database API key (https://www.themoviedb.org/settings/api)
TMDB_API_KEY=your_tmdb_api_key_here
# Recommended: HuggingFace read-only token (https://huggingface.co/settings/tokens)
# Not required for this public model, but recommended — anonymous
# downloads are rate-limited. Required if you swap MODEL_ID for a gated model
# (Llama, etc.). huggingface_hub reads this variable directly
# from the process environment before every download request — no code change
# needed in main.py or model_manager.py.
HF_TOKEN=your_readonly_hf_token_here
# HuggingFace Hub model identifier for emotion classification
# `MODEL_ID` accepts any text-classification model on the Hugging Face Hub (https://huggingface.co/models?pipeline_tag=text-classification)
MODEL_ID=tabularisai/multilingual-emotion-classification
# Specific commit hash to pin for reproducibility; leave blank to use the default pinned version
# MODEL_REVISION accepts a commit SHA from the model's HuggingFace repository
MODEL_REVISION=24895f06e3f50c532aa29c400e6708b57db1c16d
