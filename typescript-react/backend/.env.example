# Number of top emotion labels returned per text in API responses
TOP_EMOTIONS=3
# Local path where HuggingFace caches model weights — maps to the Render persistent disk
HF_HOME=/model_cache
# Load the model at startup instead of waiting for the first request
EAGER_LOAD=true
# Set to 0 to keep the model loaded; increase to unload after N idle seconds
IDLE_UNLOAD_SECONDS=0
# Maximum characters per text input before truncation
MAX_INPUT_CHARS=1000
# Disable Python stdout buffering for real-time log streaming in containerized environments
PYTHONUNBUFFERED=1
# Port the uvicorn server listens on
PORT=8000
# Quantize the model to INT8 to roughly halve RAM with negligible accuracy loss
QUANTIZE_MODEL=true
# Dummy inference run at startup to absorb PyTorch's one-time lazy-initialization cost
WARMUP_TEXT=This movie was absolutely fantastic.
# Max intra-op CPU threads PyTorch uses — align with your service's vCPU allocation
TORCH_NUM_THREADS=2
# Max inter-op CPU threads — 1 is a safe default for small CPU models
TORCH_INTEROP_THREADS=1
# Max seconds to wait for the library service before returning a 504 error
LIBRARY_TIMEOUT_SECONDS=5.0
# Optional: Redis URL for emotion score caching. If unset, inference runs on every request.
REDIS_URL=redis://redis:6379
# Cache key namespace — bump to invalidate all cached scores after a model swap
CACHE_VERSION=v1
# TTL in seconds for cached emotion scores (default: 7 days — reviews are immutable)
EMOTIONS_CACHE_TTL=604800
